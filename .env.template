# Google Services API Keys
# DO NOT COMMIT YOUR ACTUAL .env FILE!

# Google Civic Information API Key (for "Check My Ballot")
GOOGLE_CIVIC_API_KEY=your_civic_api_key_here

# Google Maps Platform API Key (for Places Autocomplete and Maps JS)
# Note: This key will also need to be accessible to the frontend via a config/script injection.
GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# OpenAI API Key (for intelligent chatbot responses)
OPENAI_API_KEY=your_openai_api_key_here

# Server Port
PORT=3000
